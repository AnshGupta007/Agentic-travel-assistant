# Multi-Modal Agentic Travel Assistant Environment Configuration

# Provider Mode: MOCK (no external API keys required) or LIVE
PROVIDER_MODE=MOCK

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vector Store Path (ChromaDB persistence)
VECTOR_STORE_PATH=./data/vector_store

# External Service Live API Keys (optional when PROVIDER_MODE=MOCK)
OPENWEATHER_API_KEY=your_openweather_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
UNSPLASH_API_KEY=your_unsplash_api_key_here
